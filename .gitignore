# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Data and model caches -- never commit these (see README: Datasets).
# Anchored with a leading slash: an unanchored `data/` also matches
# src/tsfm_peft/data/ and configs/data/, which silently excluded the whole data
# package from the repository.
/data/
/cache/
/.cache/

# Run outputs. Metrics JSON under results/ IS committed; checkpoints are not.
# Fine-tuned adapters land in results/adapters/<experiment>/; the weights are covered
# by *.safetensors below but the directory carries a config and a card too.
/results/adapters/
# Per-arm stdout from scripts/run_all.sh. Concurrent arms cannot share a terminal legibly,
# so each writes its own; the artifact is the record, not the log.
/logs/
/runs/
/checkpoints/
*.ckpt
*.safetensors
wandb/

# OS / editor
.DS_Store
.idea/
.vscode/
